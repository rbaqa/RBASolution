<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="RBA Unit + API verification (no browser)" verbose="1" parallel="methods" thread-count="2">
    <listeners>
        <listener class-name="techrba.listener.TestListener"/>
        <listener class-name="techrba.retry.AnnotationTransformer"/>
    </listeners>
    <test name="Unit + API Tests">
        <packages>
            <package name="techrba.unit"/>
            <package name="techrba.api"/>
        </packages>
    </test>
</suite>

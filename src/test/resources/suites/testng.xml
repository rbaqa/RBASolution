<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="RBA QA Suite" verbose="1" parallel="tests" thread-count="2">

    <!-- Global listener + retry transformer -->
    <listeners>
        <listener class-name="techrba.listener.TestListener"/>
        <listener class-name="techrba.listener.TestSummaryListener"/>
        <listener class-name="techrba.retry.AnnotationTransformer"/>
    </listeners>

    <test name="Unit + API Tests (REST)">
        <packages>
            <package name="techrba.unit"/>
            <package name="techrba.api"/>
        </packages>
    </test>

    <test name="UI Tests - Exchange Calculator (Selenium)">
        <packages>
            <package name="techrba.selenium"/>
        </packages>
    </test>
</suite>

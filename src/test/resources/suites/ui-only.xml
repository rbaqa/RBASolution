<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="RBA UI-only (Selenium)" verbose="1">
    <listeners>
        <listener class-name="techrba.listener.TestListener"/>
        <listener class-name="techrba.listener.TestSummaryListener"/>
        <listener class-name="techrba.retry.AnnotationTransformer"/>
    </listeners>
    <test name="Selenium Tests">
        <packages>
            <package name="techrba.selenium"/>
        </packages>
    </test>
</suite>
